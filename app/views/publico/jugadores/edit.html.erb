<% content_for :title, "Cambiar nombre | Rubípticos" %>

<main class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <h1>Cambiar nombre</h1>
      <p>Conservás tu historial, tus puntos y tu racha.</p>

      <% if @jugador.bloqueado? %>
        <p class="alert alert-warning" role="alert">
          Cambiar el nombre no quita el bloqueo. Solo la administración puede desbloquearte.
        </p>
      <% end %>

      <%= form_with model: @jugador, url: jugador_path do |form| %>
        <%= render "campos_nombre", form: form, jugador: @jugador, sugerencia: @sugerencia %>
        <%= form.submit "Guardar cambios", class: "btn btn-primary" %>
      <% end %>

      <%= link_to "Cancelar", root_path, class: "d-inline-block mt-3" %>
    </div>
  </div>
</main>
