<div data-controller="chatbot" data-action="turbo:before-cache@document->chatbot#cerrar">
  <nav aria-label="Principal" class="border-bottom">
    <div class="container d-flex justify-content-between align-items-center py-2">
      <%= link_to "Rubípticos", root_path, class: "navbar-brand fw-bold" %>
      <%= link_to "Cómo se juega", chatbot_path, class: "btn btn-outline-primary",
                  aria: { haspopup: "dialog", controls: "panel_chatbot" }, data: { action: "chatbot#abrir" } %>
    </div>
  </nav>

  <dialog id="panel_chatbot" class="chatbot-panel rounded-3 shadow p-0" aria-labelledby="titulo_chatbot"
          data-chatbot-target="panel">
    <header class="d-flex align-items-center justify-content-between border-bottom p-3">
      <h2 id="titulo_chatbot" class="h5 mb-0">Cómo se juega</h2>
      <button type="button" class="btn btn-sm btn-outline-secondary" autofocus data-action="chatbot#cerrar">Cerrar</button>
    </header>
    <div class="p-3" aria-live="polite">
      <%= turbo_frame_tag "chatbot_nodo", data: { chatbot_target: "marco", action: "turbo:frame-load->chatbot#recordar" } do %>
        <p>Cargando la guía…</p>
      <% end %>
    </div>
  </dialog>
</div>
