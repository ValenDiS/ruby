<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h3 mb-0">Jugadores</h1>
  <%= button_to "Reiniciar tabla de posiciones", reiniciar_tabla_admin_jugadores_path, class: "btn btn-outline-danger",
                form: { data: { turbo_confirm: "¿Reiniciar la tabla? Solo van a contar las partidas que se resuelvan desde ahora." } } %>
</div>

<p class="text-body-secondary">
  <% if @tabla_reiniciada_at %>
    La tabla se reinició por última vez el <%= l(@tabla_reiniciada_at, format: :long) %>.
  <% else %>
    La tabla nunca se reinició.
  <% end %>
</p>

<div class="table-responsive">
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Puntos</th>
        <th>Racha</th>
        <th>Estado</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @jugadores.each do |jugador| %>
        <tr>
          <td><%= jugador.nombre %></td>
          <td><%= jugador.puntos_totales %></td>
          <td><%= jugador.racha_actual %></td>
          <td>
            <% if jugador.bloqueado? %>
              <span class="badge text-bg-danger">Bloqueado</span>
            <% else %>
              <span class="badge text-bg-success">Activo</span>
            <% end %>
          </td>
          <td class="text-end">
            <%= button_to jugador.bloqueado? ? "Desbloquear" : "Bloquear", admin_jugador_path(jugador),
                          method: :patch, params: { jugador: { bloqueado: !jugador.bloqueado? } },
                          class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @jugadores.empty? %>
  <p>Todavía no hay jugadores.</p>
<% end %>
