<h1 class="h3 mb-3">Puntajes</h1>
<p class="text-body-secondary">
  Puntos base = puntos del tipo × multiplicador de la dificultad.
  Los cambios solo afectan a las partidas que se resuelvan después.
</p>

<div class="row g-4">
  <div class="col-12 col-lg-7">
    <h2 class="h5">Puntos por tipo <small class="text-body-secondary">(entre 10 y 1000)</small></h2>
    <table class="table align-middle">
      <tbody>
        <% @puntajes.each do |puntaje| %>
          <tr>
            <td><%= t("cripticos.tipos.#{puntaje.tipo}") %></td>
            <td>
              <%= form_with model: [ :admin, puntaje ], class: "d-flex gap-2" do |form| %>
                <%= form.number_field :puntos, min: 10, max: 1000, step: 1, required: true, class: "form-control form-control-sm" %>
                <%= form.submit "Guardar", class: "btn btn-sm btn-outline-primary" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="col-12 col-lg-5">
    <h2 class="h5">Multiplicador por dificultad <small class="text-body-secondary">(mayor que 0, hasta 5)</small></h2>
    <table class="table align-middle">
      <tbody>
        <% @multiplicadores.each do |multiplicador| %>
          <tr>
            <td><%= t("cripticos.dificultades.#{multiplicador.dificultad}") %></td>
            <td>
              <%= form_with model: [ :admin, multiplicador ], class: "d-flex gap-2" do |form| %>
                <%= form.number_field :valor, min: 0.01, max: 5, step: 0.01, required: true, class: "form-control form-control-sm" %>
                <%= form.submit "Guardar", class: "btn btn-sm btn-outline-primary" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
